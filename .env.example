RESEND_API_KEY=__I_WILL_PROVIDE_LATER__
CONTACT_FROM_EMAIL=__I_WILL_PROVIDE_LATER__
# Optional. Used for canonical URLs, sitemap and social cards.
# Example: https://ibrahim-portfolio-pro-7c0c.vercel.app
NEXT_PUBLIC_SITE_URL=https://ibrahim-portfolio-pro-7c0c.vercel.app
